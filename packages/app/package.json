{
  "name": "claudetop-app",
  "productName": "claudetop",
  "version": "0.1.0",
  "description": "claudetop Electron desktop app",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p electron/tsconfig.json && vite build",
    "dev": "concurrently \"tsc -p electron/tsconfig.json --watch\" \"vite\" \"electron .\"",
    "test": "vitest run --passWithNoTests",
    "package": "electron-builder"
  },
  "dependencies": {
    "@claudetop/core": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "latest"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.0.0"
  }
}
